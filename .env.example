# ═══════════════════════════════════════════════════════════
# ARIA — .env.example
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Telegram (REQUIRED) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Groq (REQUIRED) ──────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# ── Gmail / Google ────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=
GMAIL_PUBSUB_TOPIC=

# ── WhatsApp ──────────────────────────────────────────────
BAILEYS_HOST=baileys
BAILEYS_PORT=3001

# ── Discord ───────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# ── Slack ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Notion ────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_NOTES_DB_ID=
NOTION_TASKS_DB_ID=

# ── GitHub ────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPOS=

# ── Spotify ───────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ── SMS Gateway ───────────────────────────────────────────
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# ── Monitoring ────────────────────────────────────────────
STOCK_WATCHLIST=
CRYPTO_WATCHLIST=
RSS_FEEDS=
KEYWORD_ALERTS=

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=aria
POSTGRES_USER=aria
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

MINIO_ROOT_USER=aria
MINIO_ROOT_PASSWORD=changeme_strong_password
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=aria-storage

# ── Preferences ───────────────────────────────────────────
BRIEFING_TIME=08:00
TIMEZONE=Asia/Kolkata
IMPORTANCE_THRESHOLD=6
DRAFT_MODE=false
FOLLOW_UP_DAYS=3
LANGUAGE=en
